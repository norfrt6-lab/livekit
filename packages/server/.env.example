# LiveKit Configuration
# Get these from your LiveKit Cloud dashboard or self-hosted instance
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here
LIVEKIT_WS_URL=wss://your-livekit-server.livekit.cloud

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Token TTL (time to live) in seconds
# Host/Guest tokens: 24 hours
HOST_TOKEN_TTL=86400
# Viewer tokens: 12 hours
VIEWER_TOKEN_TTL=43200
